{
  "name": "qa-copilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.copiloto.qa",
    "productName": "Copiloto QA",
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "package.json",
      "!.env",
      "!transcripciones",
      "!PLAN-*.md"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false
    }
  }
}
